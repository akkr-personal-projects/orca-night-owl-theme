{
  "base": "dark",
  "tokens": {
    "--background": "#011627",
    "--editor-surface": "#011627",
    "--foreground": "#d6deeb",
    "--card": "#0b253a",
    "--card-foreground": "#d6deeb",
    "--popover": "#0b253a",
    "--popover-foreground": "#d6deeb",
    "--primary": "#82aaff",
    "--primary-foreground": "#011627",
    "--secondary": "#102a44",
    "--secondary-foreground": "#d6deeb",
    "--muted": "#102a44",
    "--muted-foreground": "#89a4bb",
    "--accent": "#1d3b53",
    "--accent-foreground": "#d6deeb",
    "--border": "#122d42",
    "--input": "#0b253a",
    "--ring": "#82aaff",
    "--sidebar": "#001122",
    "--sidebar-foreground": "#89a4bb",
    "--sidebar-accent": "#0b2942",
    "--sidebar-accent-foreground": "#d6deeb",
    "--sidebar-border": "#102a44",
    "--sidebar-ring": "#82aaff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#637777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#c5e478"
      }
    },
    {
      "name": "Built-in constants",
      "scope": [
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.character.numeric"
      ],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "Null and boolean",
      "scope": [
        "constant.language.null",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#ff5874"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7fdbca"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#ecc48d"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f78c6c"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#82aaff"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ffcb8b"
      }
    },
    {
      "name": "Support types",
      "scope": [
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c5e478"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#7fdbca"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c5e478"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#caece6"
      }
    },
    {
      "name": "HTML punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7fdbca"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d6deeb"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quoted text",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#637777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ef5350"
      }
    }
  ]
}
